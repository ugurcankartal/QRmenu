# Copy to Backend/.env on the server:
# cp deploy/env/backend.env.example Backend/.env
# nano Backend/.env

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=harbi-kebap.com,www.harbi-kebap.com
DJANGO_SECURE_SSL_REDIRECT=true

CSRF_TRUSTED_ORIGINS=https://harbi-kebap.com,https://www.harbi-kebap.com
CORS_ALLOWED_ORIGINS=https://harbi-kebap.com,https://www.harbi-kebap.com
# Yerel gelistirme (config.settings.dev) localhost originlerini otomatik ekler.
FRONTEND_URL=https://harbi-kebap.com

PROD_RUNSERVER_HOST=127.0.0.1
PROD_RUNSERVER_PORT=8526

PROD_DB_NAME=harbiqrmenu
PROD_DB_USER=harbiqrmenu
PROD_DB_PASSWORD=change-me
PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=3306

GROQ_API_KEY=
GROQ_API_URL=
GROQ_MODEL=
GROQ_BATCH_PAUSE_SECONDS=1
GUNICORN_TIMEOUT=600

PROD_EMAIL_HOST=localhost
PROD_EMAIL_PORT=587
PROD_EMAIL_HOST_USER=
PROD_EMAIL_HOST_PASSWORD=
PROD_EMAIL_USE_TLS=true
PROD_DEFAULT_FROM_EMAIL=noreply@harbi-kebap.com
