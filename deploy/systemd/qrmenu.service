# Install: sudo cp deploy/systemd/qrmenu.service /etc/systemd/system/qrmenu.service
#         sudo systemctl daemon-reload
#         sudo systemctl enable --now qrmenu
#
# Port: deploy/scripts/start-gunicorn.sh reads Backend/.env -> PROD_RUNSERVER_PORT

[Unit]
Description=QRmenu Gunicorn (harbi-kebap.com)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/harbiqrmenu/Backend
ExecStart=/home/ubuntu/harbiqrmenu/deploy/scripts/start-gunicorn.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
